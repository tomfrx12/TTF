# ==============================================================================
# CONFIGURATION DE BASE DE DONNÉES (DOCKER POSTGRES)
# ==============================================================================
# Identifiants qui seront injectés dans le conteneur Docker PostgreSQL
DB_USER="votre_utilisateur_ici"
DB_PASSWORD="votre_mot_de_passe_secret_ici"
DB_NAME="nom_de_la_base_de_donnees"

# URL de connexion utilisée par le Prisma Client pour communiquer avec la DB
# Laisse localhost:5432 pour le développement local avec Docker Desktop
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?schema=public"

# ==============================================================================
# CONFIGURATION INTERFACE VISUELLE (PGADMIN)
# ==============================================================================
# Identifiants requis pour te connecter sur http://localhost:5050
PGADMIN_EMAIL="votre_email@messagerie.fr"
PGADMIN_PASSWORD="votre_mot_de_passe_visuel_ici"